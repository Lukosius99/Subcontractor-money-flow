# Build output
bin/
obj/
publish/
binBuildCheck*/

# Working database (lives in C:\ProgramData on a deployed machine; never commit the live copy)
data/
data/*.db
data/*.db-shm
data/*.db-wal
*.db-wal
*.db-shm
*.db-journal
*.log
logs/
*.tmp
*.bak
*.zip

# Throwaway dev/test fixtures and logs (~48 MB, not needed to run the app)
test-data/
test-data/*store*.json

# Local tooling / IDE
.vs/
*.user
.claude/
.idea/
.vscode/

# Local imports and exports can contain company data
imports/
temp/
tmp/

# NOTE: seed/monthly-money-flow.db IS tracked on purpose — it is the bundled
# initial dataset the deploy script restores on a fresh machine.
