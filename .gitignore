# .NET build and test output
bin/
obj/
publish/
artifacts/
TestResults/
coverage/
binBuildCheck*/

# SQLite databases and transient files (live or copied data must never enter Git)
data/
seed/
test-data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
# Išimtis: naujausia atsarginė DB kopija laikoma repozitorijoje (žr. Backup-MoneyFlowDb.ps1)
!db-backups/monthly-money-flow-latest.db*

# Logs, backups, archives, and temporary output
logs/
*.log
*.tmp
*.bak
*.old
*.zip
temp/
tmp/
output/
exports/
pad-output/
power-automate-output/

# Local imports/exports can contain company or personal data
imports/
test-data/*store*.json

# Secrets and machine-specific configuration
.env
.env.*
!.env.example
api-key.txt
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json

# IDE and tool state
.vs/
.idea/
.vscode/
.claude/
*.suo
*.user
*.userosscache

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
